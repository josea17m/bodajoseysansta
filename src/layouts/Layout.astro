---
import "../styles/global.css";
import { Image } from "astro:assets";
import flowerBannerBottom from "../assets/flower-banner-bottom.png";
import {
  getLangFromUrl,
  getPathWithoutLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";

export interface Props {
  title: string;
}

const { title } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const currentPath = getPathWithoutLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const navItems = [
  { path: "/", label: t("nav.home") },
  { path: "/schedule", label: t("nav.schedule") },
  { path: "/registry", label: t("nav.registry") },
  { path: "/gallery", label: t("nav.gallery") },
  { path: "/attire", label: t("nav.attire") },
  { path: "/faqs", label: t("nav.faqs") },
  { path: "/zoom", label: t("nav.zoom") },
  { path: "/rsvp", label: t("nav.rsvp"), cta: true },
];

const isActive = (path: string) => currentPath === path;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Nunito:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="shell">
      <div class="garland" aria-hidden="true">
        <svg class="swag" viewBox="0 0 1200 70" preserveAspectRatio="none">
          <path
            d="M0 10 C 160 76, 340 76, 500 10 S 840 -56, 1200 10"
            fill="none"
            stroke="#BFA787"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>
        <div class="bulbs">
          {Array.from({ length: 12 }).map(() => (
            <span class="bulb"><span class="wire"></span><span class="cap"></span><span class="glow"></span></span>
          ))}
        </div>
      </div>

      <header class="topbar">
        <div class="container topbar-inner">
          <a class="brand" href={translatePath("/")}>Sansta & Jose Ale</a>
          <nav class="nav" aria-label="Main navigation">
            {navItems.map((item) => (
              <a
                href={translatePath(item.path)}
                class:list={[isActive(item.path) && "active", item.cta && "nav-cta"]}
              >
                {item.label}
              </a>
            ))}
            <span class="nav lang-nav" aria-label="Language">
              <a href={translatePath(currentPath, "es")} data-lang-switch class:list={[lang === "es" && "active"]}>ES</a>
              <a href={translatePath(currentPath, "en")} data-lang-switch class:list={[lang === "en" && "active"]}>EN</a>
            </span>
          </nav>
          <button class="menu-btn" id="menuBtn" aria-label={t("nav.openMenu")} aria-controls="mobileNav" aria-expanded="false">
            <span></span>
          </button>
        </div>
        <nav class="container mobile-nav" id="mobileNav" aria-label="Mobile navigation">
          {navItems.map((item) => (
            <a
              href={translatePath(item.path)}
              class:list={[isActive(item.path) && "active", item.cta && "nav-cta"]}
            >
              {item.label}
            </a>
          ))}
          <a href={translatePath(currentPath, "es")} data-lang-switch class:list={[lang === "es" && "active"]}>ES</a>
          <a href={translatePath(currentPath, "en")} data-lang-switch class:list={[lang === "en" && "active"]}>EN</a>
        </nav>
      </header>

      <main class="page">
        <slot />
      </main>

      <div class="flower-banner-wrap">
        <Image src={flowerBannerBottom} alt="Flower banner" class="flower-banner" />
      </div>

      <footer class="footer">
        <div class="container">
          <div class="fbrand">Sansta & Jose Ale</div>
          <nav class="flinks" aria-label="Footer navigation">
            {navItems.map((item) => <a href={translatePath(item.path)}>{item.label}</a>)}
          </nav>
          <div class="fhash">{t("home.hero.hashtag")}</div>
        </div>
      </footer>
    </div>

    <div class="lang-modal" id="langModal" role="dialog" aria-modal="true" aria-labelledby="langModalTitle" hidden>
      <div class="lang-modal-card">
        <p class="lm-eyebrow">Welcome &middot; Bienvenidos</p>
        <h2 class="lm-title" id="langModalTitle">Sansta &amp; Jose Ale</h2>
        <p class="lm-sub">Please choose your language<br />Por favor elige tu idioma</p>
        <div class="lm-actions">
          <a class="lm-btn lm-primary" href={translatePath(currentPath, "en")} data-lang-pick="en">English</a>
          <a class="lm-btn lm-ghost" href={translatePath(currentPath, "es")} data-lang-pick="es">Español</a>
        </div>
      </div>
    </div>

    <script define:vars={{ currentLang: lang }}>
      // Recordar el idioma visitado para la redirección de la raíz "/"
      try {
        localStorage.setItem("preferredLang", currentLang);
      } catch {
        // Ignore storage errors so the page still renders normally.
      }

      // Popup de idioma: aparece solo si el usuario aún no ha elegido
      const langModal = document.getElementById("langModal");
      let alreadyChosen = null;
      try {
        alreadyChosen = localStorage.getItem("langChosen");
      } catch {
        alreadyChosen = null;
      }

      if (!alreadyChosen && langModal) {
        langModal.hidden = false;
        document.body.classList.add("modal-open");
      }

      const markChosen = (l) => {
        try {
          localStorage.setItem("langChosen", "1");
          localStorage.setItem("preferredLang", l);
        } catch {
          // continuar aunque falle el storage
        }
      };

      langModal?.querySelectorAll("[data-lang-pick]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          const picked = btn.getAttribute("data-lang-pick");
          markChosen(picked);
          // Si ya está en ese idioma, solo cerrar (sin recargar)
          if (picked === currentLang) {
            e.preventDefault();
            langModal.hidden = true;
            document.body.classList.remove("modal-open");
          }
          // Si es el otro idioma, el enlace navega normalmente
        });
      });

      // Si cambian el idioma con el switch ES/EN, no volver a preguntar
      document.querySelectorAll("[data-lang-switch]").forEach((a) => {
        a.addEventListener("click", () => {
          try {
            localStorage.setItem("langChosen", "1");
          } catch {
            // ignore
          }
        });
      });

      const menuBtn = document.getElementById("menuBtn");
      const mobileNav = document.getElementById("mobileNav");
      menuBtn?.addEventListener("click", () => {
        const isOpen = mobileNav?.classList.toggle("open") ?? false;
        menuBtn.setAttribute("aria-expanded", String(isOpen));
      });
    </script>
  </body>
</html>
