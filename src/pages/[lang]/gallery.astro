---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const galleryItems = [
  { aspect: "4 / 5", tag: "S & J", image: "/images/ring.webp" },
  { aspect: "1 / 1", tag: "Jul 24", image: "/images/venue.webp" },
  { aspect: "4 / 6", tag: lang === "es" ? "Momentos" : "Moments" },
  { aspect: "4 / 4.5", tag: lang === "es" ? "Familia" : "Family" },
  { aspect: "4 / 5.5", tag: lang === "es" ? "Amigos" : "Friends" },
  { aspect: "1 / 1", tag: lang === "es" ? "Celebrar" : "Celebrate" },
  { aspect: "4 / 6", tag: lang === "es" ? "Recuerdos" : "Memories" },
  { aspect: "4 / 5", tag: "Houston" },
];
---

<Layout title={`${t("gallery.title")} · Sansta & Jose Ale`}>
  <section class="block">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "Recuerdos" : "Memories"}</span>
        <h1 class="script-title">{lang === "es" ? "Galería" : "Gallery"}</h1>
        <p>{t("gallery.intro")}</p>
      </div>

      <div class="gal-masonry">
        {galleryItems.map((item) => (
          <div class="gal-item">
            {item.image ? (
              <div class="media-frame" style={`aspect-ratio: ${item.aspect};`}>
                <img src={item.image} alt={item.tag} />
              </div>
            ) : (
              <div class="photo-slot" style={`aspect-ratio: ${item.aspect};`}>
                <span class="tag">{item.tag}</span>
              </div>
            )}
            <span class="gal-hint">{lang === "es" ? "Ver foto" : "View photo"}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
