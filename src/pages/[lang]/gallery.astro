---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const galleryImages = [
  "/images/js-80.jpg",
  "/images/js-79.jpg",
  "/images/js-77.jpg",
  "/images/js-75.jpg",
  "/images/js-76.jpg",
  "/images/js-87.jpg",
  "/images/js-44.jpg",
  "/images/IMG_6934.jpg",
  "/images/IMG_6925.jpg",
  "/images/IMG_6916.jpg",
  "/images/IMG_6929.jpg",
  "/images/IMG_6976.jpg",
  "/images/IMG_6978.jpg",
  "/images/IMG_1651.jpg",
  "/images/IMG_5068.jpg",
  "/images/IMG_5118.jpg",
  "/images/IMG_5416.jpg",
  "/images/IMG_5566.jpeg",
];
---

<Layout title={`${t("gallery.title")} · Sansta & Jose Ale`}>
  <section class="block">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "Recuerdos" : "Memories"}</span>
        <h1 class="script-title">{lang === "es" ? "Galería" : "Gallery"}</h1>
        <p>{t("gallery.intro")}</p>
      </div>

      <div class="gal-masonry">
        {galleryImages.map((src, i) => (
          <div class="gal-item">
            <img src={src} alt={`${lang === "es" ? "Foto" : "Photo"} ${i + 1} · Sansta & Jose Ale`} loading="lazy" decoding="async" />
            <span class="gal-hint">{lang === "es" ? "Ver foto" : "View photo"}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
