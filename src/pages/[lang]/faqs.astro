---
import Layout from "../../layouts/Layout.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqs = [
  { q: t("faq.q1"), a: t("faq.a1") },
  { q: t("faq.q2"), a: t("faq.a2") },
  { q: t("faq.q4"), a: t("faq.a4") },
  { q: t("faq.q5"), a: t("faq.a5") },
  { q: t("faq.q6"), a: t("faq.a6") },
  { q: t("faq.q7"), a: t("faq.a7") },
  { q: t("faq.q8"), a: t("faq.a8") },
];
---

<Layout title={`${t("faqs.title")} · Sansta & Jose Ale`}>
  <section class="block">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "Detalles útiles" : "Helpful details"}</span>
        <h1 class="script-title">{lang === "es" ? "Preguntas frecuentes" : "FAQs"}</h1>
        <p>{t("faqs.intro")}</p>
      </div>

      <div class="faq-list">
        {faqs.map((faq, index) => (
          <article class:list={["faq", index === 0 && "open"]}>
            <button class="faq-q" type="button" aria-expanded={index === 0 ? "true" : "false"}>
              <span>{faq.q}</span>
              <span class="chev">+</span>
            </button>
            <div class="faq-a">
              <div class="inner">{faq.a}</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <script>
    document.querySelectorAll(".faq-q").forEach((button) => {
      button.addEventListener("click", () => {
        const item = button.closest(".faq");
        const isOpen = item?.classList.toggle("open") ?? false;
        button.setAttribute("aria-expanded", String(isOpen));
      });
    });
  </script>
</Layout>
