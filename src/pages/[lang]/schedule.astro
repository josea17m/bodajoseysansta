---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import flowerBannerStraight from "../../assets/flower-banner-straight.png";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t("schedule.title")} · Sansta & Jose Ale`}>
  <div class="flower-banner-wrap">
    <Image src={flowerBannerStraight} alt="Flower banner" class="flower-banner" />
  </div>

  <section class="block" style="margin-top: -80px;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{t("schedule.date")}</span>
        <h1 class="script-title">{lang === "es" ? "Itinerario" : "Schedule"}</h1>
        <p>{t("schedule.intro")}</p>
      </div>

      <div class="timeline">
        <article class="tl-item">
          <span class="tl-dot"></span>
          <div class="tl-time">1:30 pm</div>
          <h2 class="tl-title">{lang === "es" ? "Llegada de invitados" : "Guest arrival"}</h2>
          <p class="tl-desc">{lang === "es" ? "Tiempo para llegar con calma y encontrar asiento." : "A little time to arrive, settle in, and find your seat."}</p>
        </article>
        <article class="tl-item">
          <span class="tl-dot"></span>
          <div class="tl-time">2:00 pm</div>
          <h2 class="tl-title">{t("home.venue.ceremony.title")}</h2>
          <p class="tl-desc">{t("home.venue.ceremony.name")} · 19220 Beechnut St Hall A, Richmond, TX 77407</p>
        </article>
        <article class="tl-item">
          <span class="tl-dot"></span>
          <div class="tl-time">5:30 pm – 6:30 pm</div>
          <h2 class="tl-title">{lang === "es" ? "Hora de Cócteles" : "Cocktail Hour"}</h2>
          <p class="tl-desc">{t("home.venue.reception.name")} · 1001 W 18th St, Houston, TX 77008</p>
        </article>
        <article class="tl-item">
          <span class="tl-dot"></span>
          <div class="tl-time">6:30 pm</div>
          <h2 class="tl-title">{t("home.venue.reception.title")}</h2>
          <p class="tl-desc">{t("home.venue.reception.name")} · 1001 W 18th St, Houston, TX 77008</p>
        </article>
        <article class="tl-item">
          <span class="tl-dot"></span>
          <div class="tl-time">12:00 am</div>
          <h2 class="tl-title">{lang === "es" ? "Despedida" : "Send-off"}</h2>
          <p class="tl-desc">{lang === "es" ? "Gracias por acompañarnos en este día tan especial." : "Thank you for celebrating this beautiful day with us."}</p>
        </article>
      </div>
    </div>
  </section>
</Layout>
