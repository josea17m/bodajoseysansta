---
import Layout from "../../layouts/Layout.astro";
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../../i18n/utils";
export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---
<Layout title={t("rsvp.title") + " - Sansta & Jose Ale"}>
  <header class="header">
    <button class="menu-btn" aria-label="Menú">
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        stroke="currentColor"
        stroke-width="2"
        fill="none"
        class="menu-icon">
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>
  </header>
  <main class="page-content">
    <h1 class="page-title">{t("rsvp.title")}</h1>
    <p class="rsvp-intro">
      {t("rsvp.intro")}
    </p>
    <form
      name="rsvp"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="rsvp-form"
      id="rsvpForm">
      <input type="hidden" name="form-name" value="rsvp" />
      <p class="hidden-field">
        <label>
          Don't fill this out if you're human: <input name="bot-field" />
        </label>
      </p>
      <div class="form-group">
        <label class="form-label" for="name">{t("rsvp.name")}</label>
        <input class="form-input" type="text" id="name" name="name" required />
      </div>
      <div class="form-group">
        <label class="form-label" for="email">{t("rsvp.email")}</label>
        <input
          class="form-input"
          type="email"
          id="email"
          name="email"
          required
        />
      </div>
      <div class="form-group">
        <span class="form-label">{t("rsvp.attending")}</span>
        <div class="radio-group">
          <label class="radio-option">
            <input
              type="radio"
              name="attending"
              value={t("rsvp.attending.yes")}
              required
            />
            <span>{t("rsvp.attending.yes")}</span>
          </label>
          <label class="radio-option">
            <input
              type="radio"
              name="attending"
              value={t("rsvp.attending.no")}
            />
            <span>{t("rsvp.attending.no")}</span>
          </label>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="guests">{t("rsvp.guests")}</label>
        <input
          class="form-input"
          type="number"
          id="guests"
          name="guests"
          min="1"
          max="10"
          value="1"
        />
      </div>
      <div class="form-group">
        <label class="form-label" for="message">{t("rsvp.message")}</label>
        <textarea class="form-input" id="message" name="message" rows="3"
        ></textarea>
      </div>
      <button class="submit-btn" type="submit">{t("rsvp.submit")}</button>
    </form>
    <div class="rsvp-success" id="rsvpSuccess" hidden>
      <div class="separator-small">
        <svg
          viewBox="0 0 40 20"
          width="40"
          height="20"
          fill="none"
          stroke="var(--text-accent)"
          stroke-width="2">
          <path d="M10 10 A5 5 0 1 1 20 10 A5 5 0 1 1 30 10 A5 5 0 1 1 10 10"
          ></path>
        </svg>
      </div>
      <h2 class="success-title">{t("rsvp.success.title")}</h2>
      <p class="success-message">{t("rsvp.success.message")}</p>
    </div>
    <div class="separator-small">
      <svg
        viewBox="0 0 40 40"
        width="30"
        height="30"
        fill="none"
        xmlns="http://www.w3.org/2000/svg">
        <path
          d="M12 28 C 15 20, 25 15, 30 10 C 27 18, 20 23, 15 28 Z"
          fill="#758B70"></path>
        <path
          d="M12 28 C 8 22, 12 14, 18 10 C 18 18, 14 24, 12 28 Z"
          fill="#8CA486"></path>
      </svg>
    </div>
    <footer class="mini-footer">
      <div class="heart-logo">
        <span class="names-logo">S&J</span>
        <svg
          viewBox="0 0 40 20"
          width="30"
          height="15"
          fill="none"
          stroke="var(--text-accent)"
          stroke-width="2"
          style="margin-left: 5px;">
          <path d="M10 10 A5 5 0 1 1 20 10 A5 5 0 1 1 30 10 A5 5 0 1 1 10 10"
          ></path>
        </svg>
      </div>
      <nav class="footer-nav">
        <a href={translatePath("/")}>{t("nav.home")}</a>
        <a href={translatePath("/gallery")}>{t("nav.gallery")}</a>
        <a href={translatePath("/schedule")}>{t("nav.schedule")}</a>
        <a href={translatePath("/registry")}>{t("nav.registry")}</a>
      </nav>
      <p class="credits">josealeysansta@email.com</p>
    </footer>
  </main>
</Layout>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("rsvpForm") as HTMLFormElement | null;
    const success = document.getElementById("rsvpSuccess");
    if (!form) return;
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      try {
        await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(data as any).toString(),
        });
      } catch (err) {
        // Even if the request fails (e.g. local dev without Netlify),
        // we still show the confirmation so the user gets feedback.
      }
      form.hidden = true;
      if (success) {
        success.hidden = false;
        success.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
  });
</script>
<style>
  .header {
    padding: 20px;
    display: flex;
    justify-content: flex-start;
  }
  .menu-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 10px;
    color: var(--text-accent);
  }
  .page-content {
    max-width: 800px;
    margin: 0 auto;
    padding: 40px 20px;
    text-align: center;
  }
  .page-title {
    font-family: var(--font-heading);
    color: var(--text-accent);
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: 0.3em;
    margin-bottom: 25px;
  }
  .rsvp-intro {
    font-family: var(--font-body);
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 40px;
  }
  .rsvp-form {
    max-width: 480px;
    margin: 0 auto;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hidden-field {
    display: none;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .form-label {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: 0.03em;
  }
  .form-input {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-primary);
    padding: 12px 14px;
    border: 1px solid #e2ddd8;
    border-radius: 6px;
    background-color: #fdfcfb;
    transition: border-color 0.2s ease;
    width: 100%;
  }
  .form-input:focus {
    outline: none;
    border-color: var(--text-accent);
  }
  textarea.form-input {
    resize: vertical;
  }
  .radio-group {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 4px;
  }
  .radio-option {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--text-primary);
    cursor: pointer;
  }
  .radio-option input {
    accent-color: var(--text-accent);
    width: 16px;
    height: 16px;
  }
  .submit-btn {
    margin-top: 10px;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: #fff;
    background-color: var(--text-accent);
    border: none;
    border-radius: 6px;
    padding: 14px 20px;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }
  .submit-btn:hover {
    background-color: #b07e69;
    transform: translateY(-1px);
  }
  .rsvp-success {
    max-width: 480px;
    margin: 0 auto;
    text-align: center;
    padding: 20px 0;
  }
  .success-title {
    font-family: var(--font-heading);
    color: var(--text-accent);
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    margin-bottom: 15px;
  }
  .success-message {
    color: var(--text-primary);
    font-size: 0.95rem;
    line-height: 1.7;
  }
  .separator-small {
    margin: 60px 0 40px;
    display: flex;
    justify-content: center;
  }
  .mini-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 15px;
    padding-top: 20px;
  }
  .heart-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .names-logo {
    font-family: "Inter", sans-serif;
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: 0.1em;
    color: var(--text-primary);
  }
  .footer-nav {
    display: flex;
    gap: 15px;
    justify-content: center;
    margin: 10px 0;
  }
  .footer-nav a {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.85rem;
  }
  .credits {
    font-size: 0.75rem;
    color: var(--text-meta);
  }
</style>
