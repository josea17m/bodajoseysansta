---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

import gents1 from "../../assets/attire-gents-1.jpg";
import gents2 from "../../assets/attire-gents-2.jpg";
import gents3 from "../../assets/attire-gents-3.jpg";
import gents4 from "../../assets/attire-gents-4.jpg";
import gents5 from "../../assets/attire-gents-5.avif";
import gents6 from "../../assets/attire-gents-6.jpg";
import gents7 from "../../assets/attire-gents-7.avif";
import gents8 from "../../assets/attire-gents-8.jpg";
import gents9 from "../../assets/attire-gents-9.jpg";
import gents10 from "../../assets/attire-gents-10.jpg";

import ladies1 from "../../assets/attire-ladies-1.jpg";
import ladies2 from "../../assets/attire-ladies-2.jpg";
import ladies3 from "../../assets/attire-ladies-3.jpg";
import ladies4 from "../../assets/attire-ladies-4.jpg";
import ladies5 from "../../assets/attire-ladies-5.jpg";
import ladies6 from "../../assets/attire-ladies-6.jpg";
import ladies8 from "../../assets/attire-ladies-8.jpg";
import ladies9 from "../../assets/attire-ladies-9.jpg";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ladiesImages = [ladies1, ladies2, ladies3, ladies4, ladies5, ladies6, ladies8, ladies9];
const gentsImages = [gents1, gents2, gents3, gents4, gents5, gents6, gents7, gents8, gents9, gents10];
---

<Layout title={`${lang === "es" ? "Vestimenta" : "Attire"} · Sansta & Jose Ale`}>
  <section class="block">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "Código de Vestimenta" : "Dress Code"}</span>
        <h1 class="script-title">{lang === "es" ? "Vestimenta" : "Attire"}</h1>
        <p>♡ {lang === "es" ? "Vestimenta formal, por favor" : "Formal attire please"}</p>
        <p>{lang === "es" ? "(La recepción será al aire libre, así que por favor usa algo fresco ☼)" : "(The reception will be outdoors, so please be sure to wear something fresh ☼)"}</p>
        <p>♡ {lang === "es" ? "El tema de colores de la boda es pasteles claros" : "The wedding color theme is light pastels"}</p>
        <p>♡ {lang === "es" ? "El novio usará un traje azul claro (Caballeros, por favor eviten usar un traje azul claro)" : "The Groom will be wearing a light blue suit (So guys, please avoid wearing a light blue suit if possible)"}</p>
      </div>

      <!-- Color Palette -->
      <div class="attire-section">
        <h2 class="attire-heading">{lang === "es" ? "Paleta de Colores" : "Color Palette"}</h2>
        <div class="color-swatches">
          <div class="swatch">
            <div class="swatch-color" style="background: #fef9c3;"></div>
            <span class="swatch-name">{lang === "es" ? "Amarillo Pastel" : "Light Yellow"}</span>
          </div>
          <div class="swatch">
            <div class="swatch-color" style="background: #d1f5d3;"></div>
            <span class="swatch-name">{lang === "es" ? "Verde Pastel" : "Light Green"}</span>
          </div>
          <div class="swatch">
            <div class="swatch-color" style="background: #fce4ec;"></div>
            <span class="swatch-name">{lang === "es" ? "Rosa Pastel" : "Light Pink"}</span>
          </div>
          <div class="swatch">
            <div class="swatch-color" style="background: #ede7f6;"></div>
            <span class="swatch-name">{lang === "es" ? "Lila Pastel" : "Light Purple"}</span>
          </div>
          <div class="swatch">
            <div class="swatch-color" style="background: #e3f2fd;"></div>
            <span class="swatch-name">{lang === "es" ? "Azul Pastel" : "Light Blue"}</span>
          </div>
          <div class="swatch">
            <div class="swatch-color" style="background: #ffe8d6;"></div>
            <span class="swatch-name">{lang === "es" ? "Naranja Pastel" : "Light Orange"}</span>
          </div>
        </div>
      </div>

      <!-- Ladies -->
      <div class="attire-section">
        <h2 class="attire-heading">♡ {lang === "es" ? "Damas" : "Ladies"}</h2>
        <div class="attire-grid">
          {ladiesImages.map((img, i) => (
            <div class="attire-item">
              <Image src={img} alt={`Ladies attire inspiration ${i + 1}`} loading="lazy" />
            </div>
          ))}
        </div>
      </div>

      <!-- Gents -->
      <div class="attire-section">
        <h2 class="attire-heading">♡ {lang === "es" ? "Caballeros" : "Gentlemen"}</h2>
        {gentsImages.length > 0 ? (
          <div class="attire-grid">
            {gentsImages.map((img, i) => (
              <div class="attire-item">
                <Image src={img} alt={`Gents attire inspiration ${i + 1}`} loading="lazy" />
              </div>
            ))}
          </div>
        ) : (
          <p class="coming-soon">{lang === "es" ? "Fotos próximamente..." : "Photos coming soon..."}</p>
        )}
      </div>

    </div>
  </section>
</Layout>

<style>
  .attire-section {
    margin-top: 48px;
  }

  .attire-heading {
    color: var(--rose-deep);
    font-family: "Cormorant Garamond", serif;
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 24px;
    text-align: center;
  }

  .color-swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: center;
  }

  .swatch {
    align-items: center;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .swatch-color {
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    height: 80px;
    width: 80px;
  }

  .swatch-name {
    color: var(--ink-soft);
    font-size: 0.85rem;
    text-align: center;
  }

  .attire-grid {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .coming-soon {
    color: var(--ink-soft);
    font-style: italic;
    text-align: center;
  }

  .attire-item img {
    border-radius: 12px;
    height: 320px;
    object-fit: cover;
    width: 100%;
  }

  @media (max-width: 520px) {
    .swatch-color {
      height: 64px;
      width: 64px;
    }

    .attire-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
