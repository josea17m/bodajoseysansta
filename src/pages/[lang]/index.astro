---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import sketchCeremony from "../../assets/sketch-ceremony.png";
import sketchReception from "../../assets/sketch-reception.png";
import flowerBanner from "../../assets/flower-banner.png";
import flowerBannerTop from "../../assets/flower-banner-top.png";
import flowerBannerStraight from "../../assets/flower-banner-straight.png";
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../../i18n/utils";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Photos live in src/assets/photos and are optimized at build time by
// astro:assets (resized + WebP). Look them up by filename.
const photoModules = import.meta.glob("../../assets/photos/*.{jpg,jpeg,png,webp}", {
  eager: true,
  import: "default",
});
const photo = (file) => {
  const entry = Object.entries(photoModules).find(([path]) => path.endsWith("/" + file));
  if (!entry) throw new Error("Image not found: " + file);
  return entry[1];
};

// Hero ribbon photos.
const heroSlides = [
  { img: photo("js-80.jpg"), alt: "Sansta & Jose Ale" },
  { img: photo("IMG_6925.jpg"), alt: "Sansta & Jose Ale" },
  { img: photo("js-79.jpg"), alt: "Sansta & Jose Ale" },
  { img: photo("js-77.jpg"), alt: "Sansta & Jose Ale" },
  { img: photo("js-75.jpg"), alt: "Sansta & Jose Ale" },
  { img: photo("js-87.jpg"), alt: "Sansta & Jose Ale" },
];

const drawing = photo("us-drawing.webp");
const locket = photo("locket-cut.webp");
const rings = photo("IMG_6934.jpg");
---

<Layout title={`Sansta & Jose Ale · ${t("home.hero.date")}`}>
  <section class="hero container">
    <div class="hero-top">
      <div class="hero-side hero-drawing">
        <Image src={drawing} alt={lang === "es" ? "Sansta y Jose Ale" : "Sansta and Jose Ale"} width={600} format="webp" quality={80} />
      </div>
      <div class="hero-center">
        <span class="eyebrow">{lang === "es" ? "La boda de" : "The wedding of"}</span>
        <h1>
          Sansta <span class="amp">&amp;</span><br />Jose Ale
        </h1>
        <div class="date-row">
          <span>{lang === "es" ? "Julio" : "July"}</span>
          <span class="pip"></span>
          <span>24</span>
          <span class="pip"></span>
          <span>2026</span>
        </div>
        <p class="loc">{t("home.hero.location")}</p>
      </div>
    </div>

    <div class="flower-banner-wrap">
      <Image src={flowerBannerStraight} alt="Flower banner" class="flower-banner" />
    </div>

    <div class="hero-ribbon" aria-label={lang === "es" ? "Galería de fotos" : "Photo gallery"}>
      <div class="ribbon-track" aria-hidden="false">
        {[...heroSlides, ...heroSlides].map((slide) => (
          <div class="ribbon-slide">
            <Image src={slide.img} alt={slide.alt} height={1000} format="webp" quality={75} loading="eager" decoding="async" />
          </div>
        ))}
      </div>
    </div>

    <div class="countdown" id="countdown" aria-live="polite"></div>

    <div class="locket-feature">
      <Image src={locket} alt={lang === "es" ? "Relicario Jose Alejandro y Sansta" : "Jose Alejandro and Sansta locket"} width={900} format="webp" quality={80} loading="lazy" decoding="async" />
    </div>
  </section>

  <section class="block tint">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "El gran día" : "The big day"}</span>
        <h2 class="script-title">{lang === "es" ? "Dónde celebramos" : "Where we celebrate"}</h2>
        <p>{t("schedule.intro")}</p>
      </div>

      <div class="venues">
        <article class="venue card">
          <Image src={sketchCeremony} alt="Ceremony sketch" class="venue-sketch" />
          <div class="kind eyebrow">{t("home.venue.ceremony.title")}</div>
          <h3>2:00 pm</h3>
          <p class="vname">{t("home.venue.ceremony.name")}</p>
          <p class="vaddr">19220 Beechnut St Hall A<br />Richmond, TX 77407</p>
          <a
            class="vlink"
            href="https://maps.google.com/?q=19220+Beechnut+St+Hall+A,+Richmond,+TX+77407"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t("schedule.map")}
          </a>
        </article>
        <article class="venue card">
          <Image src={sketchReception} alt="Reception sketch" class="venue-sketch" />
          <div class="kind eyebrow">{t("home.venue.reception.title")}</div>
          <h3>5:30 pm</h3>
          <p class="vname">{t("home.venue.reception.name")}</p>
          <p class="vaddr">1001 W 18th St<br />Houston, TX 77008</p>
          <a
            class="vlink"
            href="https://maps.google.com/?q=1001+W+18th+St,+Houston,+TX+77008"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t("schedule.map")}
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="rsvp-cta">
    <div class="container">
      <a class="btn btn-primary btn-xl" href={translatePath("/rsvp")}>{t("nav.rsvp")}</a>
    </div>
  </section>

  <div class="flower-banner-wrap">
    <Image src={flowerBannerTop} alt="Flower banner" class="flower-banner" />
  </div>

  <section class="block">
    <div class="container story">
      <div class="media-frame">
        <Image src={rings} alt={lang === "es" ? "Anillos de boda" : "Wedding rings"} width={1100} format="webp" quality={80} loading="lazy" decoding="async" />
      </div>
      <div>
        <span class="eyebrow muted">{t("home.story.title")}</span>
        <p class="pull">{lang === "es" ? "Una historia suave, luminosa y nuestra." : "A soft, bright story of our own."}</p>
        <p>{t("home.story.p1")}</p>
        <p>{t("home.story.p2")}</p>
      </div>
    </div>
  </section>

  <script
    define:vars={{
      countdownTranslations: {
        ready: t("home.countdown.ready"),
        days: t("home.countdown.days"),
        hours: t("home.countdown.hours"),
        minutes: t("home.countdown.minutes"),
        seconds: t("home.countdown.seconds"),
      },
    }}
  >
    const countdownElement = document.getElementById("countdown");
    const weddingDate = new Date("2026-07-24T14:00:00-05:00").getTime();

    function updateCountdown() {
      if (!countdownElement) return;

      const distance = weddingDate - Date.now();
      if (distance < 0) {
        countdownElement.textContent = countdownTranslations.ready;
        return;
      }

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      countdownElement.innerHTML = `
        <span class="cd-cell"><span class="num">${days}</span><span class="lab">${countdownTranslations.days}</span></span>
        <span class="cd-cell"><span class="num">${hours}</span><span class="lab">${countdownTranslations.hours}</span></span>
        <span class="cd-cell"><span class="num">${minutes}</span><span class="lab">${countdownTranslations.minutes}</span></span>
        <span class="cd-cell"><span class="num">${seconds}</span><span class="lab">${countdownTranslations.seconds}</span></span>
      `;
    }

    updateCountdown();
    setInterval(updateCountdown, 1000);
  </script>
</Layout>
