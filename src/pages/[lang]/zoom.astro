---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import flowerBannerStraight from "../../assets/flower-banner-straight.png";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`Zoom · Sansta & Jose Ale`}>
  <div class="flower-banner-wrap">
    <Image src={flowerBannerStraight} alt="Flower banner" class="flower-banner" />
  </div>

  <section class="block" style="margin-top: -80px;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "En Línea" : "Online"}</span>
        <h1 class="script-title">Zoom</h1>
      </div>

      <div class="zoom-card card">
        <div class="zoom-heart">♡</div>
        <p class="zoom-message">
          {lang === "es"
            ? "Para nosotros es muy importante que quienes no puedan estar presentes también sean parte de este día tan especial. Si no puedes acompañarnos en persona, nos encantaría tenerte con nosotros de todas formas."
            : "It means the world to us that those who cannot be there in person can still be part of our special day. If you can't join us in person, we would love to have you with us all the same."}
        </p>
        <p class="zoom-message">
          {lang === "es"
            ? "El enlace de Zoom estará disponible aquí el día de la boda. ¡Vuelve el 24 de julio de 2026!"
            : "The Zoom link will be available right here on the wedding day. Check back on July 24, 2026!"}
        </p>
        <div class="zoom-placeholder">
          <span>{lang === "es" ? "Enlace disponible el 24 de julio" : "Link available on July 24"}</span>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .zoom-card {
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 40px;
    text-align: center;
  }

  .zoom-heart {
    color: var(--rose);
    font-size: 2rem;
    margin-bottom: 24px;
  }

  .zoom-message {
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .zoom-placeholder {
    margin-top: 32px;
    padding: 18px 32px;
    border: 1.5px dashed var(--blush);
    border-radius: 12px;
    color: var(--ink-soft);
    font-style: italic;
    font-size: 0.95rem;
  }
</style>
