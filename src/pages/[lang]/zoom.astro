---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import flowerBannerStraight from "../../assets/flower-banner-straight.png";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`Zoom · Sansta & Jose Ale`}>
  <div class="flower-banner-wrap">
    <Image src={flowerBannerStraight} alt="Flower banner" class="flower-banner" />
  </div>

  <section class="block" style="margin-top: -80px;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "En Línea" : "Online"}</span>
        <h1 class="script-title">Zoom</h1>
      </div>

      <div class="zoom-card card">
        <div class="zoom-heart">♡</div>
        <p class="zoom-message">
          {lang === "es"
            ? "Para nosotros es muy importante que quienes no puedan estar presentes también sean parte de este día tan especial. Si no puedes acompañarnos en persona, nos encantaría tenerte con nosotros de todas formas."
            : "It means the world to us that those who cannot be there in person can still be part of our special day. If you can't join us in person, we would love to have you with us all the same."}
        </p>
        <p class="zoom-message">
          {lang === "es"
            ? "Únete a la ceremonia el 24 de julio de 2026 a las 2:00 pm (hora de Houston) con el siguiente enlace:"
            : "Join the ceremony on July 24, 2026 at 2:00 pm (Houston time) using the link below:"}
        </p>
        <a
          class="btn zoom-join-btn"
          href="https://us06web.zoom.us/j/7038363054?pwd=9BweTYA9OKqz6DT3gdnJ5Z23RBSwzv.1&omn=85325058866"
          target="_blank"
          rel="noopener noreferrer"
        >
          {lang === "es" ? "Unirse al Zoom" : "Join Zoom"}
        </a>
        <div class="zoom-details">
          <p><span>{lang === "es" ? "ID de reunión" : "Meeting ID"}:</span> 703 836 3054</p>
          <p><span>{lang === "es" ? "Código de acceso" : "Passcode"}:</span> 240726</p>
        </div>
      </div>

    </div>
  </section>
</Layout>

<style>
  .zoom-card {
    max-width: 600px;
    margin: 0 auto;
    padding: 48px 40px;
    text-align: center;
  }

  .zoom-heart {
    color: var(--rose);
    font-size: 2rem;
    margin-bottom: 24px;
  }

  .zoom-message {
    color: var(--ink-soft);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 16px;
  }

  .zoom-join-btn {
    margin-top: 16px;
  }

  .zoom-details {
    margin-top: 28px;
    padding: 18px 32px;
    border: 1.5px solid var(--blush);
    border-radius: 12px;
    color: var(--ink-soft);
    font-size: 0.95rem;
    display: inline-block;
  }

  .zoom-details p {
    margin: 4px 0;
  }

  .zoom-details span {
    font-weight: 600;
  }
</style>
