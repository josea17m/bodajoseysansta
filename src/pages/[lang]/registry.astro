---
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import flowerBannerStraight from "../../assets/flower-banner-straight.png";
import giftIcon from "../../assets/gift-icon.png";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout title={`${t("registry.title")} · Sansta & Jose Ale`}>
  <div class="flower-banner-wrap">
    <Image src={flowerBannerStraight} alt="Flower banner" class="flower-banner" />
  </div>

  <section class="block" style="margin-top: -80px;">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow muted">{lang === "es" ? "Con cariño" : "With love"}</span>
        <Image src={giftIcon} alt="Gift icon" class="gift-icon" />
        <h1 class="script-title">{lang === "es" ? "Mesa de regalos" : "Registry"}</h1>
        <p>{t("registry.intro1")}</p>
      </div>

      <div class="reg-grid">
        <article class="reg-card card">
          <div class="reg-emoji" style="background: var(--rose);">A</div>
          <h2>{t("registry.amazon")}</h2>
          <p>{t("registry.amazon.desc")}</p>
          <a
            class="btn btn-primary btn-block"
            href="https://www.amazon.com/wedding/guest-view/1TB8MRZ8XR7PW"
            target="_blank"
            rel="noopener noreferrer"
          >
            {t("registry.amazon.cta")}
          </a>
        </article>
      </div>

      <div class="honeyfund card">
        <h3>{lang === "es" ? "Gracias por ser parte" : "Thank you for being part of it"}</h3>
        <p>{lang === "es" ? "Su presencia es lo más especial para nosotros. Cada detalle lo recibimos con muchísimo amor. ♡" : "Your presence is the most special to us. Every detail is received with so much love. ♡"}</p>
        <div class="progress" aria-hidden="true"><div style="width: 62%;"></div></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gift-icon {
    display: block;
    height: 64px;
    margin: 0 auto 8px;
    width: auto;
  }
</style>
