---
import { defaultLang } from "../i18n/ui";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sansta &amp; Jose Ale</title>
    <script define:vars={{ defaultLang }}>
      // Redirige al idioma ya visitado, o al inglés por defecto.
      // La pregunta de idioma (popup) la maneja el Layout en la página destino.
      const supported = new Set(["es", "en"]);
      let pref = null;
      try {
        pref = localStorage.getItem("preferredLang");
      } catch {
        pref = null;
      }
      const target = pref && supported.has(pref) ? pref : defaultLang;
      window.location.replace(`/${target}/`);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=/${defaultLang}/`} />
    </noscript>
  </head>
  <body></body>
</html>
